  "description": "Hybrid POS app built with Vue, Vite, Capacitor, Firebase, and Bluetooth ESC/POS thermal printing for Android.",
  "type": "module",
  "keywords": [
    "pos",
    "vue",
    "vite",
    "capacitor",
    "android",
    "firebase",
    "thermal-printer",
