  "repository": {
    "type": "git",
    "url": "https://github.com/naufalraihans/miniProject-POS.git"
  },
  "bugs": {
    "url": "https://github.com/naufalraihans/miniProject-POS/issues"
  },
  "homepage": "https://github.com/naufalraihans/miniProject-POS",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "npx cap sync",
